@page "/peliculas/editar/{Id:int}"
@inject NavigationManager navigationManager

<h3>Editar Pelicula</h3>

@if(pelicula is null)
{
    <Cargando />
}
else
{
    <FormularioPelicula FormularioInvalido="false" FormularioPosteadoConExito="formularioPosteadoConExito" PosteoEnCurso="posteoEnCurso" OnValidSubmit="Editar" Pelicula="pelicula" GenerosNoSeleccionados="GeneroNoSeleccionados" GenerosSeleccionados="GeneroSeleccionados" />
}


@code {
    [Parameter] public int Id { get; set; }
    private bool formularioPosteadoConExito = false;
    private bool posteoEnCurso = false;
    private Pelicula pelicula = null!;

    private List<Genero> GeneroNoSeleccionados = new List<Genero>();
    private List<Genero> GeneroSeleccionados = new List<Genero>();

    protected override void OnInitialized()
    {
        pelicula = new()
        {
            Id = Id,
            Titulo = "Pelicula 1",
            FechaLanzamiento = new DateTime(2012, 05, 25),
            EnCartelera = true,
            Trailer = "ABC",
            PosterURL = "https://thumb.wikimedia.org/wikipedia/commons/thumb/1/18/TomHolland-byPhilipRomano.jpg/960px-TomHolland-byPhilipRomano.jpg?utm_source=es.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail"
        };

        GeneroNoSeleccionados = new List<Genero>()
        {
            new Genero(){Id = 1, Nombre = "Comedia"},
            new Genero(){Id = 3, Nombre = "Romance"},
            new Genero(){Id = 4, Nombre = "Accion"},
            new Genero(){Id = 5, Nombre = "Ciencia ficcion"}
        };

        GeneroSeleccionados = new List<Genero>()
        {
            new Genero(){Id = 2, Nombre = "Drama"}
        };
    }

    private async Task Editar()
    {
        if (!posteoEnCurso)
        {
            posteoEnCurso = true;
            Console.WriteLine("Ejecutando metodo editar");
            await Task.Delay(2000);
            Console.WriteLine($"Titulo: {pelicula.Titulo}");
            Console.WriteLine($"Fecha de lanzamiento: {pelicula.FechaLanzamiento}");
            Console.WriteLine($"Hay imagen: {pelicula.PosterArchivo is not null}");
            Console.WriteLine($"En cartelera: {pelicula.EnCartelera}");
            posteoEnCurso = false;
            formularioPosteadoConExito = true;
            StateHasChanged();
            navigationManager.NavigateTo($"/peliculas/{Id}");

            Console.WriteLine("Generos seleccionados");
            pelicula.GenerosPelicula.ForEach(x => Console.WriteLine(x.GeneroId));
        }
    }
}

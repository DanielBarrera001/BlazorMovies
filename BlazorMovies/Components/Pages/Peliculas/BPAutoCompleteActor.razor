<div>
    <label>Actores:</label>
    <div>
        <MudAutocomplete T="Actor" Placeholder="Seleccione un actor"
            SearchFunc="Search" ToStringFunc="@(e=>null)"
        Value="actorSeleccionado" ValueChanged="ValueChanged" @ref="mudAutocomplete"> 
            <ItemTemplate Context="actor">
                <img style="width: 50px" src="@actor.FotoURL" /> @actor.Nombre
            </ItemTemplate>
        </MudAutocomplete>

        <ul class="list-group">
            @foreach (var item in ActoresSeleccionados)
            {
                <li draggable="true" 
                    @ondragstart="@(() => HandleDragStart(item))"
                    @ondragover="@(() => HandleDragOver(item))"
                    class="list-group-item list-group-item-action">
                    @item.Nombre / <input type="text" placeholder="Personaje" @bind="item.Personaje"/>

                    <span @onclick="@(() => ActoresSeleccionados.Remove(item))" class="badge bg-primary rounded-pill" style="cursor: pointer">
                        X
                    </span>
                </li>
            }
        </ul>
    </div>
</div>

@code {

    [Parameter] public List<Actor> ActoresSeleccionados { get; set; } = [];
    Actor? actorSeleccionado;
    private MudAutocomplete<Actor>? mudAutocomplete;
    Actor? itemArrastrado;

    private async Task<IEnumerable<Actor>> Search (string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return new List<Actor>();
        }

        var lista = new List<Actor>
        {
            new() {Id =1, Nombre = "Tom Holland", FotoURL="https://thumb.wikimedia.org/wikipedia/commons/thumb/1/18/TomHolland-byPhilipRomano.jpg/960px-TomHolland-byPhilipRomano.jpg?utm_source=es.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail" },
            new() {Id =2, Nombre = "Tom Hanks", FotoURL="https://thumb.wikimedia.org/wikipedia/commons/thumb/1/18/TomHolland-byPhilipRomano.jpg/960px-TomHolland-byPhilipRomano.jpg?utm_source=es.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},
            new() {Id =3, Nombre = "Samuel L. Jackson Hanks", FotoURL="https://thumb.wikimedia.org/wikipedia/commons/thumb/1/18/TomHolland-byPhilipRomano.jpg/960px-TomHolland-byPhilipRomano.jpg?utm_source=es.wikipedia.org&utm_campaign=imageinfo&utm_content=thumbnail"}
        };

        return lista.Where(x => x.Nombre!.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    async Task ValueChanged(Actor actor)
    {
        if(actor is null)
        {
            return;
        }

        if(!ActoresSeleccionados.Any(x => x!.Equals(actor)))
        {
            ActoresSeleccionados.Add(actor);
        }

        actorSeleccionado = null;

        await mudAutocomplete!.ClearAsync();
    }

    private void HandleDragStart(Actor item)
    {
        itemArrastrado = item;
    }

    private void HandleDragOver(Actor item)
    {
        if(itemArrastrado is null)
        {
            return;
        }

        if (!item!.Equals(itemArrastrado))
        {
            var indiceElementoArrastrado = ActoresSeleccionados.IndexOf(itemArrastrado);
            var indiceElemento = ActoresSeleccionados.IndexOf(item);
            ActoresSeleccionados[indiceElemento] = itemArrastrado;
            ActoresSeleccionados[indiceElementoArrastrado] = item;
        }
    }


}

@using BlazorMovies.Components.Compartidos.SelectorMultiple
<FormularioEntidad Entidad="Pelicula" FormularioPosteadoConExito="FormularioPosteadoConExito" PosteoEnCurso="PosteoEnCurso" OnValidSubmit="PosteoFormulario" FormularioInvalido="FormularioInvalido">

    <BPInputText Label="Titulo" @bind-Value="@Pelicula.Titulo" />
    <BPInputText Label="Trailer" @bind-Value="@Pelicula.Trailer" />
    <BPInputDate Label="Fecha de lanzamiento" @bind-Value="@Pelicula.FechaLanzamiento" />
    <BPCheckBox Label="En Cartelera" @bind-Value="@Pelicula.EnCartelera" />
    <InputImage Label="Poster" ImagenSeleccionada="archivo => Pelicula.PosterArchivo = archivo" ImagenURL="@Pelicula.PosterURL"/>
    <SelectorMultiple Label="Generos" Seleccionados="Seleccionados" NoSeleccionados="NoSeleccionados" />

</FormularioEntidad>

@code {
    [Parameter] public List<Genero> GenerosSeleccionados { get; set; } = [];
    [Parameter] public List<Genero> GenerosNoSeleccionados { get; set; } = [];
    [Parameter, EditorRequired] public Pelicula Pelicula { get; set; } = null!;
    [Parameter, EditorRequired] public bool FormularioPosteadoConExito { get; set; } = false;
    [Parameter, EditorRequired] public bool PosteoEnCurso { get; set; } = false;
    [Parameter, EditorRequired] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public bool FormularioInvalido { get; set; } = true;

    private List<SelectorMultipleModelo> Seleccionados { get; set; } = [];
    private List<SelectorMultipleModelo> NoSeleccionados { get; set; } = [];

    protected override void OnInitialized()
    {
        Seleccionados = GenerosSeleccionados.Select(x => new SelectorMultipleModelo(x.Id.ToString(), x.Nombre!)).ToList();

        NoSeleccionados = GenerosNoSeleccionados.Select(x => new SelectorMultipleModelo(x.Id.ToString(), x.Nombre!)).ToList();
    }

    private async Task PosteoFormulario()
    {
        Pelicula.GenerosPelicula = Seleccionados.Select(x => new GeneroPelicula
            {
                GeneroId = int.Parse(x.Identificador)
            }).ToList();

            await OnValidSubmit.InvokeAsync();
    }

}
